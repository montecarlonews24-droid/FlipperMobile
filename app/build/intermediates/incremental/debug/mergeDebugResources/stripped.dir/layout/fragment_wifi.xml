<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="مسح الشبكات فقط" android:textColor="@color/red"
            android:textSize="11sp" android:gravity="center" android:padding="10dp"
            android:background="@drawable/bg_warning" android:layout_marginBottom="10dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:padding="12dp" android:background="@drawable/bg_card" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/wifiTotal" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="@color/green" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="شبكة" android:textColor="@color/dim" android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:padding="12dp" android:background="@drawable/bg_card" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/wifiOpen" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="@color/orange" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="مفتوحة" android:textColor="@color/dim" android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:padding="12dp" android:background="@drawable/bg_card">
                <TextView android:id="@+id/wifiStrong" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textColor="@color/cyan" android:textSize="24sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="قوية" android:textColor="@color/dim" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>
        <Button android:id="@+id/btnScanWifi" android:layout_width="match_parent"
            android:layout_height="56dp" android:text="ابدأ مسح WiFi"
            android:textColor="@color/green" android:backgroundTint="@color/panel"
            android:layout_marginBottom="10dp"/>
        <ProgressBar android:id="@+id/wifiProgress" android:layout_width="match_parent"
            android:layout_height="4dp" android:indeterminate="true"
            android:visibility="gone" android:layout_marginBottom="10dp"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvWifi"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>
        <TextView android:id="@+id/wifiLog" android:layout_width="match_parent"
            android:layout_height="160dp" android:background="@color/panel"
            android:padding="12dp" android:text="WIFI v1.0"
            android:textColor="@color/green" android:textSize="11sp"
            android:fontFamily="monospace" android:gravity="bottom" android:layout_marginTop="12dp"/>
    </LinearLayout>
</ScrollView>